# Backend environment template — copy to .env and fill in real values
APP_NAME=InsightFlow
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://insightflow:insightflow_dev@localhost:5432/insightflow
DATABASE_POOL_SIZE=20
DATABASE_POOL_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_REPORTS=insightflow-reports
MINIO_BUCKET_MODELS=insightflow-models
MINIO_SECURE=false

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
OPENAI_API_KEY=

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

CORS_ORIGINS=http://localhost:3000
